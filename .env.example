# Supabase project credentials (Phase 1 — Auth only: customers + admin_users).
# Copy this file to .env and fill in your own project's values from
# Project Settings → API in the Supabase dashboard.
#
# VITE_SUPABASE_ANON_KEY is a PUBLIC, browser-safe key (protected by Row
# Level Security) — never put the service_role/secret key in a Vite env
# var, since anything prefixed VITE_ is bundled into client-side JS.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
